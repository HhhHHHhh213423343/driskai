PUBLIC_HOST=your-domain.example.com

POSTGRES_DB=business_ai
POSTGRES_USER=business_ai
POSTGRES_PASSWORD=change-this-password

FASTGPT_BASE_URL=https://your-fastgpt.example.com
FASTGPT_API_KEY=
FASTGPT_DATASET_ID=
FASTGPT_DATASET_UPSERT_PATH=/api/core/dataset/data_push
FASTGPT_CHAT_PATH=/chat/completions

# Optional. When unset, the company detail page falls back to the local company profile.
QICHACHA_ENABLED=true
QICHACHA_APP_KEY=
QICHACHA_SECRET_KEY=

# Windows/macOS 企业全景采集 Worker 专用。请使用至少 32 位随机值。
COLLECTION_API_KEY=

CSRC_MONITOR_ROOT_HOST=./data/csrc-monitor
